# Plantilla de variables de entorno de gym-app. SIN valores reales: este archivo SÍ se sube a git.
# Copia este archivo como .env.local y pega tus valores ahí (.env.local nunca se sube a git).

# Dirección de tu proyecto Supabase (pública). Supabase Dashboard > Settings > API Keys / Data API.
NEXT_PUBLIC_SUPABASE_URL=

# Clave PUBLICABLE (empieza por sb_publishable_). Viaja al navegador; es segura porque
# la protección real la dan las políticas de la base de datos (RLS, Fase 1).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# NO pongas aquí la clave SECRETA (sb_secret_...). Hoy no se usa; si algún día hace falta,
# irá SOLO en .env.local, sin el prefijo NEXT_PUBLIC_, y nunca en el navegador ni en el chat.
